# PRism 全栈部署环境变量模板
# 复制为 deploy/.env 后按需修改。deploy.sh / deploy.ps1 会从 services/gateway/.env 合并已配置项。

# ---- 数据库 ----
DATABASE_URL=postgresql+psycopg://prism:prism@postgres:5432/prism

# ---- 引擎 ----
# 0 = C++ gRPC 引擎；1 = Python stub（新机首次部署推荐 1，脚本会自动设置）
PRISM_STUB_ENGINE=0
ENGINE_GRPC_ADDR=engine:50051

# ---- 前端 / 应用 URL ----
API_URL=http://gateway:3001
FRONTEND_URL=http://localhost:3000
APP_URL=http://localhost:3000

# ---- 认证 ----
# 生成: openssl rand -hex 32
JWT_SECRET=<generate>
JWT_EXPIRE_MINUTES=10080
# 生成: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=<generate>
GITHUB_OAUTH_CLIENT_ID=<your-client-id>
GITHUB_OAUTH_CLIENT_SECRET=<your-client-secret>
OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/github/callback

# ---- GitHub 集成（按需）----
GITHUB_PAT=<your-pat>
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=prism-reviewly

# ---- 生产安全 ----
PRISM_AUTH_BYPASS=0
PRISM_SEED_DB=0
PRISM_FAIL_ON_MIGRATION_ERROR=1
PRISM_ALLOW_LEGACY_SYNC=0
DEBUG=0

# ---- 持久化 ----
PRISM_REPO_CACHE_DIR=/data/repo-cache

# ---- Git 私有仓库（可选）----
# 格式: https://user:token@github.com
# GIT_CREDENTIALS=

# ---- AI 配置 ----
# API Key 保存在数据库 settings 中，由 UI 配置；无需在此填写。
# 若 services/gateway/.env 中有额外变量，部署脚本会自动合并。
