{
  "name": "reviewly",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-docker.mjs",
    "dev:docker": "node scripts/dev-docker.mjs",
    "dev:local": "concurrently -n web,gateway -c cyan,green \"npm run dev -w @reviewly/web\" \"npm run dev:gateway\"",
    "dev:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-clean.ps1",
    "dev:gateway": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-gateway.ps1",
    "dev:db": "docker compose -f deploy/docker-compose.yml up -d postgres",
    "kill:gateway": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1 -Port 3001",
    "kill:web": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/kill-port.ps1 -Port 3000",
    "dev:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev-engine.ps1",
    "build": "npm run build -w @reviewly/shared && npm run build -w @reviewly/web",
    "lint": "npm run lint -w @reviewly/web && npm run typecheck",
    "typecheck": "npm run typecheck -w @reviewly/shared && npm run typecheck -w @reviewly/web",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location services/gateway; if (-not (Test-Path .venv)) { python -m venv .venv }; .venv\\Scripts\\python -m pytest\"",
    "test:e2e": "python scripts/test_review_center_workbench.py",
    "clean": "node scripts/clean.mjs",
    "start:app": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start.ps1",
    "deploy": "node scripts/deploy.mjs",
    "stop": "node scripts/stop.mjs",
    "uninstall": "node scripts/uninstall.mjs",
    "uninstall:purge": "node scripts/uninstall.mjs --purge"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
