# PostgreSQL (recommended) or SQLite for local dev without Docker:
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism
# DATABASE_URL=sqlite:///./prism.db

PRISM_STUB_ENGINE=1
# Seed runs automatically on empty DB. Set to 1 only if you need to document forced reload workflows.
PRISM_SEED_DB=0
APP_URL=http://localhost:3000
ENGINE_GRPC_ADDR=localhost:50051

# B3 GitHub App (optional)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=prism-reviewly
# Required for repository import/sync and strongly recommended for PR import.
# Unauthenticated GitHub API is limited to ~60 req/h and returns 403 rate-limit errors.
# Create at https://github.com/settings/tokens — scopes: `repo` (private) or `public_repo` (public only).
GITHUB_PAT=

# B10 settings encryption — 64-char hex (32 bytes): openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=
