# Gateway 本地开发配置（评委/演示，与 deploy/.env 中 OAuth 一致）
# 使用 npm run dev 前可复制: cp .env.example .env
#
# 数据库（npm run dev 启动时自动探测，无需手改即可兼容多种环境）:
#   auto（默认）— 先试 .env 中 Postgres，不通则回退 SQLite（services/gateway/prism.db）
#   postgres     — 仅 Postgres，失败则 Gateway 不启动
#   sqlite       — 仅用 SQLite
# PRISM_DATABASE_MODE=auto
# 启动 Docker Postgres: npm run dev:db
DATABASE_URL=postgresql+psycopg://prism:prism@localhost:5432/prism

PRISM_STUB_ENGINE=1
PRISM_SEED_DB=0
APP_URL=http://localhost:3000
ENGINE_GRPC_ADDR=localhost:50051

GITHUB_OAUTH_CLIENT_ID=Ov23liteuIPwA2AlwPxX
GITHUB_OAUTH_CLIENT_SECRET=b2f5dd1834767d91d02a8aa8948ad597e6bf2733
JWT_SECRET=2eef69954faf4c6740c87924c3bb50b24601ca7d3a68c4d0c6dae39ce7c56ce5
JWT_EXPIRE_MINUTES=10080
OAUTH_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
FRONTEND_URL=http://localhost:3000
SETTINGS_ENCRYPTION_KEY=a690060ecf96fe85e1042d3cf52ca54618b8a7d9ae25ebec982aab66b8e9c49c

PRISM_AUTH_BYPASS=0
PRISM_ALLOW_LEGACY_SYNC=0

GITHUB_PAT=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_SLUG=prism-reviewly
